{
  "manifest_version": 3,
  "name": "Job Application Sheet Tracker",
  "version": "1.1.0",
  "description": "1-click save any job application details from LinkedIn, Indeed, Greenhouse, or any web page directly into your Google Sheet.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Track Job Application (Alt+Shift+J)",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+J",
        "mac": "Alt+Shift+J"
      },
      "description": "Open Job Tracker"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
